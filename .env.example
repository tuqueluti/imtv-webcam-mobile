# Banco Turso/libSQL. Configure também nas variáveis da Vercel.
TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
TURSO_AUTH_TOKEN=SEU-TOKEN
# Opcional, somente para teste local: TURSO_DATABASE_URL=file:local.db (sem token).

# Se conectar pelo Marketplace com Custom Prefix IMTV, o app também reconhece
# IMTV_URL + IMTV_AUTH_TOKEN, IMTV_DATABASE_URL + IMTV_AUTH_TOKEN, ou
# IMTV_TURSO_DATABASE_URL + IMTV_TURSO_AUTH_TOKEN, conforme os nomes gerados.
# Use o par completo da mesma conexão.
